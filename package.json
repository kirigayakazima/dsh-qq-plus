{
  "name": "@dsh/qq-plus",
  "version": "0.2.1",
  "description": "QQ 机器人增强插件：集成群聊入站唤醒门控（小满/阿醒双角色自适应）与出站消息拟人化断句打字节奏，支持 Heart Protocol v1 状态感知联动。",
  "type": "module",
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./split": {
      "default": "./lib/split.js"
    },
    "./wake": {
      "default": "./lib/wake-gate.js"
    },
    "./personas": {
      "default": "./lib/personas.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "patches",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "qqbot",
    "split",
    "wake",
    "heart",
    "im"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  }
}
